.home { min-height: 100vh; display: flex; flex-direction: column; background: #fafaf7; color: #14252a; }
.brand-strip { height: 172rpx; padding: 20rpx 38rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; background: #fff; }
.brand-logo { width: 100%; height: 132rpx; }
.hero { display: flex; flex-direction: column; align-items: flex-start; min-height: 590rpx; padding: 58rpx 48rpx 62rpx; box-sizing: border-box; border-bottom-left-radius: 56rpx; background: #173b3c; color: #fff; }
.eyebrow { margin-bottom: 40rpx; color: #a4d6c2; font-size: 24rpx; font-weight: 600; letter-spacing: 3rpx; }
.title { display: flex; flex-direction: column; font-size: 60rpx; line-height: 1.3; font-weight: 700; letter-spacing: -1rpx; }
.description { margin-top: 28rpx; color: #c7dbd5; font-size: 27rpx; line-height: 1.6; }
.hero-action { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; min-width: 264rpx; margin-top: 44rpx; padding: 22rpx 34rpx; border-radius: 80rpx; background: #f4efdc; color: #20423d; font-size: 28rpx; font-weight: 700; }
.hero-action-active { background: #e4dfcd; }
.quick-start { flex: 1; padding: 36rpx 36rpx 34rpx; }
.section-title { display: block; margin: 0 4rpx 26rpx; color: #6e7c7b; font-size: 29rpx; font-weight: 600; }
.entry { position: relative; display: flex; flex-direction: column; align-items: flex-start; min-height: 208rpx; margin-bottom: 20rpx; padding: 30rpx 36rpx; box-sizing: border-box; border-radius: 36rpx; color: #173033; }
.entry-guest { background: #e6eee8; }
.entry-internal { background: #efefec; }
.entry-active { opacity: .82; }
.entry-kicker { margin-bottom: 17rpx; color: #6d9788; font-size: 20rpx; letter-spacing: 3rpx; }
.entry-title { margin-bottom: 8rpx; font-size: 35rpx; font-weight: 700; }
.entry-description { color: #617973; font-size: 23rpx; line-height: 1.5; }
.entry-arrow { position: absolute; top: 82rpx; right: 38rpx; font-size: 44rpx; line-height: 1; }
.bottom-nav { display: flex; align-items: center; justify-content: space-around; min-height: 126rpx; padding-bottom: env(safe-area-inset-bottom); border-top: 1rpx solid #e5e9e5; background: #fff; }
.nav-item { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2rpx; width: 25%; min-height: 104rpx; color: #82918e; font-size: 21rpx; text-align: center; }
.nav-icon { font-size: 40rpx; line-height: 1.2; }
.nav-current { color: #267459; }
