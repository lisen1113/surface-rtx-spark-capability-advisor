.home{min-height:100vh;display:flex;flex-direction:column;background:#fff;color:#14181f}
.brand-strip{height:142rpx;padding:30rpx 44rpx;box-sizing:border-box;display:flex;align-items:center;justify-content:flex-start;gap:24rpx;background:#fff}
.brand-logo{width:200rpx;height:78rpx;flex-shrink:0}.brand-divider{width:1rpx;height:52rpx;background:#e4e9f0;flex-shrink:0}.surface-brand{width:380rpx;height:60rpx;overflow:hidden;position:relative;flex-shrink:0}.surface-brand image{position:absolute;width:476rpx;left:-50rpx;top:-50rpx}
.hero{display:flex;flex-direction:column;align-items:flex-start;margin:0 26rpx;padding:46rpx 44rpx 42rpx;border-radius:38rpx;background:linear-gradient(115deg,#eaf5ff,#f0f8f6 65%,#f3f9ee);color:#14181f;position:relative;overflow:hidden}
.eyebrow{margin-bottom:24rpx;color:#0f6cbd;font-size:21rpx;font-weight:650;letter-spacing:3rpx}.title{display:flex;flex-direction:column;font-size:58rpx;line-height:1.35;font-weight:650;letter-spacing:-1rpx}.description{margin-top:23rpx;color:#667386;font-size:25rpx;line-height:1.7}
.hero-action{display:flex;align-items:center;gap:40rpx;margin-top:30rpx;padding:0;background:transparent;color:#0f6cbd;font-size:25rpx;font-weight:600}.hero-action-active{opacity:.7}
.quick-start{flex:1;padding:40rpx 34rpx 30rpx}.section-title{display:block;margin:0 8rpx 26rpx;color:#14181f;font-size:30rpx;font-weight:650}
.entry{position:relative;display:flex;flex-direction:column;align-items:flex-start;min-height:156rpx;margin-bottom:22rpx;padding:28rpx 32rpx;box-sizing:border-box;border:1rpx solid #e4e9f0;border-radius:28rpx;background:#fff;color:#14181f}
.entry-query{background:linear-gradient(110deg,#f2f8ff,#fff);border-color:#d5e6f8}.entry-query .entry-kicker,.entry-query .entry-arrow{color:#0f6cbd}.entry-guest{background:#fff}.entry-guest .entry-kicker{color:#b8410f}.entry-guest .entry-arrow{color:#fff;background:#f25022;width:48rpx;height:48rpx;line-height:44rpx;text-align:center;border-radius:50%}.entry-internal .entry-kicker,.entry-internal .entry-arrow{color:#4c7a17}
.entry-active{opacity:.8}.entry-kicker{margin-bottom:9rpx;color:#667386;font-size:18rpx;font-weight:600;letter-spacing:2rpx}.entry-title{margin-bottom:7rpx;font-size:31rpx;font-weight:650}.entry-description{color:#667386;font-size:23rpx;line-height:1.5;padding-right:38rpx}.entry-arrow{position:absolute;top:59rpx;right:30rpx;font-size:34rpx;color:#8d9cae}
.bottom-nav{display:flex;align-items:center;justify-content:space-around;min-height:118rpx;padding-bottom:env(safe-area-inset-bottom);border-top:1rpx solid #edf1f5;background:#fff}.nav-item{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5rpx;width:25%;min-height:98rpx;color:#8695a8;font-size:21rpx;text-align:center}.nav-icon{font-size:38rpx;line-height:1.2}.nav-current{color:#0f6cbd}
.entry-workplace{background:linear-gradient(110deg,#edf8f1,#fff);border-color:#cfdfd5;box-shadow:0 6rpx 0 #d8e9de}.entry-workplace .entry-kicker,.entry-workplace .entry-arrow{color:#327455}
